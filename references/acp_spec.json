{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgenticCommerceProtocolSpec",
  "description": "Standardized schema definitions for the OpenAI & Stripe Agentic Commerce Protocol (ACP).",
  "definitions": {
    "Address": {
      "type": "object",
      "required": ["name", "line1", "city", "state", "postal_code", "country"],
      "properties": {
        "name": { "type": "string" },
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postal_code": { "type": "string" },
        "country": { "type": "string", "minLength": 2, "maxLength": 2 }
      }
    },
    "LineItem": {
      "type": "object",
      "required": ["sku", "quantity"],
      "properties": {
        "sku": { "type": "string" },
        "quantity": { "type": "integer", "minimum": 1 },
        "unit_price": { "type": "number", "minimum": 0 },
        "title": { "type": "string" }
      }
    },
    "ShippingOption": {
      "type": "object",
      "required": ["id", "name", "amount", "estimated_delivery"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number", "minimum": 0 },
        "estimated_delivery": { "type": "string" }
      }
    },
    "PaymentToken": {
      "type": "object",
      "required": ["type", "token"],
      "properties": {
        "type": { "type": "string", "enum": ["stripe_payment_token"] },
        "token": { "type": "string", "pattern": "^spt_(live|test)_[a-zA-Z0-9]+" },
        "max_amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "default": "usd" }
      }
    },
    "NegotiateRequest": {
      "type": "object",
      "required": ["line_items", "shipping_address"],
      "properties": {
        "cart_id": { "type": "string" },
        "line_items": {
          "type": "array",
          "items": { "$ref": "#/definitions/LineItem" },
          "minItems": 1
        },
        "shipping_address": { "$ref": "#/definitions/Address" },
        "promo_code": { "type": "string" }
      }
    },
    "NegotiateResponse": {
      "type": "object",
      "required": ["session_id", "currency", "subtotal", "tax", "shipping_options", "total_amount"],
      "properties": {
        "session_id": { "type": "string" },
        "currency": { "type": "string" },
        "subtotal": { "type": "number" },
        "tax": { "type": "number" },
        "discount_amount": { "type": "number" },
        "shipping_options": {
          "type": "array",
          "items": { "$ref": "#/definitions/ShippingOption" }
        },
        "selected_shipping_id": { "type": "string" },
        "total_amount": { "type": "number" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "CheckoutSessionRequest": {
      "type": "object",
      "required": ["session_id", "selected_shipping_id", "payment_method"],
      "properties": {
        "session_id": { "type": "string" },
        "selected_shipping_id": { "type": "string" },
        "payment_method": { "$ref": "#/definitions/PaymentToken" },
        "idempotency_key": { "type": "string" }
      }
    },
    "CheckoutSessionResponse": {
      "type": "object",
      "required": ["order_id", "status", "total_charged"],
      "properties": {
        "order_id": { "type": "string" },
        "status": { "type": "string", "enum": ["PLACED", "PROCESSING", "FAILED", "CANCELLED"] },
        "total_charged": { "type": "number" },
        "estimated_delivery": { "type": "string" },
        "fulfillment": {
          "type": "object",
          "properties": {
            "carrier": { "type": "string" },
            "tracking_number": { "type": "string" },
            "tracking_url": { "type": "string" }
          }
        }
      }
    }
  }
}
